import subprocess

def install_worker_flow(worker_ip, switch_port, switch="s1"):
    flow = f"priority=10,ip,nw_dst={worker_ip},actions=output:{switch_port}"

    result = subprocess.run(
        ["ovs-ofctl", "add-flow", switch, flow],
        capture_output=True,
        text=True
    )

    if result.returncode != 0:
        print("[SDN] Flow installation failed:", result.stderr.strip(), flush=True)
        return False

    print("[SDN] Flow installed:", flow, flush=True)
    return True
