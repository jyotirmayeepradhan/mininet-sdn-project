"""

class Handler(BaseHTTPRequestHandler):
    def send_json(self, data, status=200):
        body = json.dumps(data).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path = urlparse(self.path).path

        if path == "/":
            body = HTML.encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        elif path == "/api/state":
            self.send_json(get_state())

        else:
            self.send_json({"error": "Not found"}, 404)

    def do_POST(self):
        if self.path != "/api/submit":
            self.send_json({"error": "Not found"}, 404)
            return

        try:
            length = int(self.headers.get("Content-Length", 0))
            data = json.loads(self.rfile.read(length))
            kind = data.get("job_type")
            payload = data.get("payload", {})

            if kind not in ("sum", "factorial", "max"):
                self.send_json({"error": "Unsupported job type"}, 400)
                return

            response = manager_request({
                "type": "submit_job",
                "job_type": kind,
                "payload": payload
            })

            job_id = response.get("job_id")
            if not job_id:
                self.send_json({
                    "error": response.get("error", "Manager did not return a job_id"),
                    "manager_response": response
                }, 502)
                return

            with lock:
                jobs[job_id] = {
                    "job_type": kind,
                    "latest": response,
                    "created": time.time()
                }

            self.send_json({"job_id": job_id, "response": response})

        except Exception as e:
            self.send_json({"error": str(e)}, 400)

    def log_message(self, *args):
        pass

if __name__ == "__main__":
    print("Jackfruit SDN Dashboard starting...")
    print("Open http://localhost:8080")
    print("Keep Mininet, Ryu, manager and workers running.")
    ThreadingHTTPServer((HOST, PORT), Handler).serve_forever()
