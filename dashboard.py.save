};

$("jobform").onsubmit = async e => {
 e.preventDefault();
 $("message").textContent = "Submitting...";
 let kind = $("kind").value;
 let payload;
 if(kind === "factorial"){
   payload = {number: Number($("number").value)};
 } else {
   let nums = $("numbers").value.split(",").map(x=>Number(x.trim()));
   if(!nums.length || nums.some(x=>!Number.isFinite(x))){
     $("message").textContent = "Enter valid comma-separated numbers.";
     return;
   }
   payload = {numbers: nums};
 }
 try{
   let r = await fetch("/api/submit", {
     method:"POST",
     headers:{"Content-Type":"application/json"},
     body:JSON.stringify({job_type:kind,paylo

async function refresh(){
 try{
  let r = await fetch("/api/state");
  let d = await r.json();

  $("manager").innerHTML = d.manager ? '<span class="ok">ONLINE</span>' : '<span class="bad">OFFLINE</span>';

  let workers = Object.entries(d.workers || {});
  let online = workers.filter(([id,w])=>w.alive === true || w.alive === 1 || w.status === "alive").length;
  $("online").textContent = online+" / "+workers.length;

  $("workers").innerHTML = workers.length ? workers.map(([id,w])=>{
    let alive = w.alive === true || w.alive === 1 || w.status === "alive";
    return `<tr>
    <td>${id}</td>
    <td>${w.host || "-"}</td>
    <td class="${alive?'ok':'bad'}">${alive?'ALIVE':'UNAVAILABLE'}</td>
    <td>${w.busy ?? "-"}</td>
    <td>${w.last_heartbeat_age ?? "-"} </td></tr>`;
  }).join("") : '<tr><td colspan="5">No worker data returned. Check manager.</td></tr>';

  $("jobcount").textContent = d.jobs.length;
  $("jobs").innerHTML = d.jobs.length ? d.jobs.map(j=>`
   <tr><td>${j.id}</td><td>${j.job_type}</td><td>${j.status}</td>
   <td>${j.worker_id}</td><td>${j.attempt}</td><td>${JSON.stringify(j.result)}</td></tr>
  `).join("") : '<tr><td colspan="6">No jobs submitted from this dashboard yet.</td></tr>';

  $("flowcount").textContent = d.ovs.flows.length;
  $("flows").innerHTML = d.ovs.flows.length ? d.ovs.flows.map(f=>
   `<tr><td>${f.priority}</td><td>${f.packets}</td><td>${f.actions}</td></tr>`
  ).join("") : '<tr><td colspan="3">No flow entries returned.</td></tr>';

  $("ovs").textContent = d.ovs.switches || d.ovs.error || "No OVS information.";
  $("updated").textContent = d.time;
 }catch(e){
  $("manager").innerHTML = '<span class="bad">CONNECTION ERROR</span>';
 }
}
refresh();
setInterval(refresh,3000);
</script>
