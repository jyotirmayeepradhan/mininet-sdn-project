import json
import re
import time
import subprocess
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse

HOST = "0.0.0.0"
PORT = 8080

jobs = {}
lock = threading.Lock()

CLIENT_CODE = r'''
import socket, json, sys
msg = json.load(sys.stdin)
with socket.create_connection(("10.0.0.1", 5000), timeout=5) as s:
    s.sendall((json.dumps(msg) + "\n").encode())
    f = s.makefile("r")
    line = f.readline()
    if not line:
        raise RuntimeError("Manager returned no response")
    print(line)
'''

def run_command(args, timeout=5):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return p.stdout.strip(), p.stderr.strip(), p.returncode
    except Exception as e:
        return "", str(e), 1

def get_h1_pid():
    out, err, code = run_command(["pgrep", "-f", "mininet:h1"])
    for pid in out.split():
        args, _, _ = run_command(["ps", "-p", pid, "-o", "args="])
        if "mininet:h1" in args and "pgrep" not in args:
            return pid
    return None

def manager_request(message):
    pid = get_h1_pid()
    if not pid:
        return {"error": "Mininet h1 is not running"}

    try:
        p = subprocess.run(
            ["mnexec", "-a", pid, "python3", "-c", CLIENT_CODE],
            input=json.dumps(message),
            capture_output=True,
            text=True,
            timeout=8
        )
        if p.returncode != 0:
            return {"error": p.stderr.strip() or "Manager request failed"}

        lines = p.stdout.strip().splitlines()
        if not lines:
            return {"error": "Empty response from manager"}

        return json.loads(lines[-1])
    except Exception as e:
        return {"error": str(e)}

def get_ovs_data():
    flows, flow_error, _ = run_command(
        ["ovs-ofctl", "-O", "OpenFlow13", "dump-flows", "s1"]
    )
    switches, switch_error, _ = run_command(["ovs-vsctl", "show"])

    parsed = []
    for line in flows.splitlines():
        if "priority=" not in line:
            continue
        priority = re.search(r"priority=(\d+)", line)
        packets = re.search(r"n_packets=(\d+)", line)
        actions = re.search(r"actions=(.*)", line)
        parsed.append({
            "priority": priority.group(1) if priority else "-",
            "packets": packets.group(1) if packets else "0",
            "actions": actions.group(1) if actions else line
        })

    return {
        "flows": parsed,
        "raw_flows": flows,
        "switches": switches,
        "error": flow_error or switch_error
    }

def get_state():
    workers = manager_request({"type": "list_workers"})
    worker_data = workers.get("workers", {}) if isinstance(workers, dict) else {}

    if isinstance(worker_data, list):
        worker_data = {
            str(w.get("worker_id", w.get("name", i))): w
            for i, w in enumerate(worker_data)
        }

    with lock:
        tracked = list(jobs.items())

    job_results = []
    for jid, info in tracked:
        status = manager_request({"type": "get_status", "job_id": jid})
        if isinstance(status, dict) and not status.get("error"):
            info["latest"] = status
        current = info.get("latest", {})
        job_results.append({
            "id": jid,
            "job_type": current.get("job_type", info.get("job_type", "-")),
            "status": current.get("status", "Submitted"),
            "worker_id": current.get("worker_id", "-"),
            "result": current.get("result", "-"),
            "attempt": current.get("attempt", current.get("attempts", "-")),
            "error": current.get("error", "")
        })

    ovs = get_ovs_data()

    return {
        "workers": worker_data,
        "jobs": job_results,
        "ovs": ovs,
        "manager": not bool(workers.get("error")) if isinstance(workers, dict) else False,
        "time": time.strftime("%H:%M:%S")
    }

