import subprocess

def install_worker_flow(worker_ip, switch_port, switch="s1"):
    flow = "priority=10,ip,nw_dst=" + worker_ip + ",actions=output:" + str(switch_port)
    result = subprocess.run(
        ["sudo", "ovs-ofctl", "add-flow", switch, flow],
        capture_output=True, text=True
    )
    if result.returncode != 0:
        print("SDN flow failed:", result.stderr.strip())
        return False
    print("SDN flow installed:", flow)
    return True
