import json
import subprocess
import urllib.request

RYU_URL = "http://127.0.0.1:8080"

def install_worker_flow(worker_ip, switch_port, switch="s1"):
    dpid = 1

    flow = {
        "dpid": dpid,
        "priority": 10,
        "match": {
            "eth_type": 2048,
            "ipv4_dst": worker_ip
        },
        "actions": [
            {"type": "OUTPUT", "port": switch_port}
        ]
    }

    try:
        request = urllib.request.Request(
            RYU_URL + "/stats/flowentry/add",
            data=json.dumps(flow).encode(),
            headers={"Content-Type": "application/json"},
            method="POST"
        )

        result = subprocess.run(
            ["sudo", "mnexec", "-a", "1", "python3", "-c",
             "import urllib.request,sys; req=urllib.request.Request(sys.argv[1],data=sys.stdin.buffer.read(),headers={'Content-Type':'application/json'},method='POST'); print(urllib.request.urlopen(req).read().decode())",
             RYU_URL + "/stats/flowentry/add"],
            input=json.dumps(flow),
            capture_output=True,
            text=True
        )

        if result.returncode != 0:
            print("[RYU] Flow installation failed:", result.stderr.strip(), flush=True)
            return False

        print("[RYU] Flow installed through Ryu:", flow, flush=True)
        return True

    except Exception as exc:
        print("[RYU] Error:", exc, flush=True)
        return False
